<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>headline.others_silent</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@displays@</string>
		<key>displays</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>other</key>
			<string>%1$d paparan lain tiada bunyi</string>
		</dict>
	</dict>
	<key>menu.fix_summary</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@fixes@</string>
		<key>fixes</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>other</key>
			<string>Dibaiki %1$d kali, terkini %2$@</string>
		</dict>
	</dict>
	<key>menu.interval.seconds</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@seconds@</string>
		<key>seconds</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>other</key>
			<string>%1$d Saat</string>
		</dict>
	</dict>
	<key>note.paused</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@tries@</string>
		<key>tries</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>other</key>
			<string>Pembaikan automatik dijeda selepas %1$d percubaan. Sambung semula paparan, atau gunakan Baiki Sekarang.</string>
		</dict>
	</dict>
	<key>notify.paused.body</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@tries@</string>
		<key>tries</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>other</key>
			<string>Pembesar suara monitor anda masih senyap selepas %1$d percubaan. Cuba cabut %2$@ dan pasang semula.</string>
		</dict>
	</dict>
	<key>submenu.counts</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@silent@, %2$#@fixed@</string>
		<key>fixed</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>other</key>
			<string>dibaiki %2$d kali</string>
		</dict>
		<key>silent</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>other</key>
			<string>Tiada bunyi %1$d kali</string>
		</dict>
	</dict>
</dict>
</plist>
