<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>headline.others_silent</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@displays@</string>
		<key>displays</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%1$d ander beeldscherm heeft geen geluid</string>
			<key>other</key>
			<string>%1$d andere beeldschermen hebben geen geluid</string>
		</dict>
	</dict>
	<key>menu.fix_summary</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@fixes@</string>
		<key>fixes</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%1$d keer hersteld, laatst %2$@</string>
			<key>other</key>
			<string>%1$d keer hersteld, laatst %2$@</string>
		</dict>
	</dict>
	<key>menu.interval.seconds</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@seconds@</string>
		<key>seconds</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%1$d seconde</string>
			<key>other</key>
			<string>%1$d seconden</string>
		</dict>
	</dict>
	<key>note.paused</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@tries@</string>
		<key>tries</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Automatisch herstellen gepauzeerd na %1$d poging. Sluit het beeldscherm opnieuw aan of kies “Herstel nu”.</string>
			<key>other</key>
			<string>Automatisch herstellen gepauzeerd na %1$d pogingen. Sluit het beeldscherm opnieuw aan of kies “Herstel nu”.</string>
		</dict>
	</dict>
	<key>notify.paused.body</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@tries@</string>
		<key>tries</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Je monitorluidsprekers zijn na %1$d poging nog steeds stil. Probeer %2$@ los te koppelen en weer aan te sluiten.</string>
			<key>other</key>
			<string>Je monitorluidsprekers zijn na %1$d pogingen nog steeds stil. Probeer %2$@ los te koppelen en weer aan te sluiten.</string>
		</dict>
	</dict>
	<key>submenu.counts</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@silent@, %2$#@fixed@</string>
		<key>fixed</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%2$d keer hersteld</string>
			<key>other</key>
			<string>%2$d keer hersteld</string>
		</dict>
		<key>silent</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%1$d keer geen geluid</string>
			<key>other</key>
			<string>%1$d keer geen geluid</string>
		</dict>
	</dict>
</dict>
</plist>
