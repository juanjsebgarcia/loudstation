<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>headline.others_silent</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@displays@</string>
		<key>displays</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%1$d anderes Display hat keinen Ton</string>
			<key>other</key>
			<string>%1$d andere Displays haben keinen Ton</string>
		</dict>
	</dict>
	<key>menu.fix_summary</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@fixes@</string>
		<key>fixes</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%1$d-mal repariert, zuletzt %2$@</string>
			<key>other</key>
			<string>%1$d-mal repariert, zuletzt %2$@</string>
		</dict>
	</dict>
	<key>menu.interval.seconds</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@seconds@</string>
		<key>seconds</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%1$d Sekunde</string>
			<key>other</key>
			<string>%1$d Sekunden</string>
		</dict>
	</dict>
	<key>note.paused</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@tries@</string>
		<key>tries</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Automatische Reparatur nach %1$d Versuch pausiert. Schließ das Display neu an oder wähle „Jetzt reparieren“.</string>
			<key>other</key>
			<string>Automatische Reparatur nach %1$d Versuchen pausiert. Schließ das Display neu an oder wähle „Jetzt reparieren“.</string>
		</dict>
	</dict>
	<key>notify.paused.body</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@tries@</string>
		<key>tries</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Deine Monitorlautsprecher sind nach %1$d Versuch noch stumm. Zieh das Kabel von %2$@ ab und steck es wieder ein.</string>
			<key>other</key>
			<string>Deine Monitorlautsprecher sind nach %1$d Versuchen noch stumm. Zieh das Kabel von %2$@ ab und steck es wieder ein.</string>
		</dict>
	</dict>
	<key>submenu.counts</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@silent@, %2$#@fixed@</string>
		<key>fixed</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%2$d-mal repariert</string>
			<key>other</key>
			<string>%2$d-mal repariert</string>
		</dict>
		<key>silent</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%1$d-mal ohne Ton</string>
			<key>other</key>
			<string>%1$d-mal ohne Ton</string>
		</dict>
	</dict>
</dict>
</plist>
