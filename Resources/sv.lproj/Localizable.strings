"help.icon.green" = "Grön: ljudet fungerar på alla skärmar.";
"help.icon.grey" = "Grå: kontrollerar, en kontroll misslyckades eller ingen skärm med högtalare är ansluten.";
"help.icon.heading" = "Symbolen i menyraden";
"help.icon.orange" = "Orange: en skärm som du inte använder för ljud har tystnat. Stäng av ”%@” för att utesluta detta.";
"help.icon.red" = "Röd: dina skärmhögtalare har tystnat.";
"help.item.check_every" = "Hur ofta dina skärmhögtalare kontrolleras. En kontroll görs alltid när en skärm ansluts eller datorn vaknar.";
"help.item.check_now" = "Kontrollerar ljudet på alla skärmar direkt. Ingenting stängs av.";
"help.item.check_updates" = "Frågar GitHub om det finns en nyare version. Ingenting hämtas eller installeras åt dig.";
