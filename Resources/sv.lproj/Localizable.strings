"help.item.fix_automatically" = "Åtgärdar dina skärmhögtalare automatiskt när de tystnar, enligt beskrivningen ovan. Appen väntar medan något visas i helskärm på den skärmen.";
"help.item.follow" = "Behandlar den skärm som macOS spelar upp ljud via som dina skärmhögtalare. Stängs av när du själv väljer en skärm.";
"help.item.open_at_login" = "Startar %@ när du loggar in.";
"help.item.others" = "Dina andra skärmar med högtalare, i en fast ordning. De åtgärdas bara när du ber om det, och ”Åtgärda nu” frågar först, eftersom en åtgärd på en skärm kan tysta en annan. Om du vill använda en av dem för ljud i stället väljer du ”%@” i dess undermeny.";
"help.item.pause_for_microphone" = "Skjuter upp automatiska åtgärder medan någon app använder en mikrofon, så att ett samtal inte avbryts av en svart skärm. Det är avstängt som standard, eftersom du ändå inte kan höra samtalet genom dina skärmhögtalare medan de är tysta. ”Åtgärda nu” fungerar alltid.";
"help.item.show_log" = "Visar loggfilen, som registrerar varje kontroll och åtgärd. Den är till hjälp när du rapporterar ett problem.";
"help.item.speakers" = "Skärmen vars högtalare du använder, överst i listan, och om ljudet fungerar. Från dess undermeny kan du åtgärda den direkt, vilket gör skärmen svart i cirka 3 sekunder.";
"help.item.warn_other_displays" = "Gör symbolen orange när en skärm som du inte använder för ljud tystnar. Stäng av det om symbolen bara ska följa dina skärmhögtalare: grön när de fungerar, röd när de inte gör det. Andra skärmar visas fortfarande i den här menyn.";
